{
  "compilerOptions": {
    // 是否生成 `.d.ts` 类型声明文件，可以根据需要启用
    "declaration": false,
    // 使用 CommonJS 模块系统，Node.js 默认使用它
    "module": "CommonJS",
    // 指定 ECMAScript 目标版本，可以根据你的需求调整
    "target": "ESNext",
    // 跳过类型声明文件的类型检查，提升编译速度
    "skipLibCheck": true,
    // 生成 source maps 以便于调试
    "sourceMap": true,
    // 启用所有严格的类型检查选项
    "strict": true,
    "useUnknownInCatchVariables": false,
    // 输出目录，将编译后的文件放到 dist 文件夹
    "outDir": "./dist",
    // 允许对 CommonJS 和 ES 模块进行互操作
    "esModuleInterop": true,
    // 强制对导入的文件名大小写保持一致
    "forceConsistentCasingInFileNames": true,
    // 允许导入 JSON 文件（比如从 package.json 中读取版本号）
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["actions", "bin", "commands", "lib"],
  "exclude": ["node_modules", "dist"]
}
